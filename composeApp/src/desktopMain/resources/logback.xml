<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <property name="LOG_DIR" value="${LOG_DIR:-logs}" />

    <!-- %fold(...) renders its sub-pattern with every exact-case occurrence of the home
         directory folded to ~ (either separator style for a Windows home), so a message or
         stack trace that reaches any appender does not name the user (F15). UI texts are
         folded per site (displayPath); logback cannot reach them. The converter class must
         stay loadable: a rule whose class is missing collapses every message on every
         appender to %PARSER_ERROR, and the status listener above is silent. The ProGuard
         keep for com.kubekubedashdash.** in proguard-rules.pro covers it. -->
    <conversionRule conversionWord="fold" class="com.kubekubedashdash.logging.HomePathConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-36.36logger{36} - %fold(%msg%n%throwable)</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <!-- The file keeps INFO and above. com.kubekubedashdash logs at DEBUG for the in-app drawer,
             and those lines name namespaces and objects; the file outlives the session and may be
             attached to a bug report, so DEBUG stays in the drawer only. Only the app's own loggers
             write to the file: the messages and stack traces of third-party libraries (fabric8,
             okhttp, netty) carry API paths and namespaces, and the app logs its own failures by shape. -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <filter class="com.kubekubedashdash.logging.AppLoggersOnlyFilter" />
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-36.36logger{36} - %fold(%msg%n%throwable)</pattern>
        </encoder>
    </appender>

    <appender name="IN_MEMORY" class="com.kubekubedashdash.logging.InMemoryAppender">
        <maxEntries>500</maxEntries>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level - %fold(%msg%throwable)</pattern>
        </encoder>
    </appender>

    <!-- IN_MEMORY backs the in-app log drawer. Attach it ONLY to com.kubekubedashdash
         so third-party DEBUG logging (e.g. a future io.fabric8/okhttp wire logger)
         can never route bearer tokens or Secret bodies into the on-screen drawer. Audit S7. -->
    <logger name="com.kubekubedashdash" level="DEBUG" additivity="true">
        <appender-ref ref="IN_MEMORY" />
    </logger>

    <logger name="io.fabric8" level="WARN" />
    <logger name="okhttp3" level="WARN" />
    <logger name="io.netty" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
